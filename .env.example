# Copia este archivo como .env.local (Git lo ignora) y completa los valores.
# Para la web en GitHub Pages las mismas variables van como secrets del repositorio.
# Si cambias algo, vuelve a compilar: Vite las fija al compilar.

# --- Obligatorias ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon

# --- Opcionales ---
# Botón "Continuar con Google" (web y app Android). Pon true solo si Google ya está configurado en Supabase.
VITE_ENABLE_GOOGLE=false

# App Android: dirección pública de la web, para enlaces que se abren fuera de la app (olvidé mi contraseña).
# VITE_APP_URL=https://TU-USUARIO.github.io/Fia-O

# App Android: dirección de la web en Vercel que sirve /api/version (actualizaciones de la app).
# Si no se define, la app consulta la tabla app_releases de Supabase directamente.
# VITE_UPDATES_URL=https://TU-PROYECTO.vercel.app

# Cambiar la ruta de publicación de la web (por defecto "/" en local y "/Fia-O/" en GitHub Pages).
# VITE_BASE=/
